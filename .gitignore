# Dependencies
node_modules/

# Compiled binaries
/server
/dist/
# Note: internal/web/dist/ is intentionally tracked — it is go:embed'd
# into the server binary, so a fresh clone needs it to `go build`.

# Go / TypeScript build caches
*.tsbuildinfo

# SQLite databases (runtime data — demo.db is regenerated by `just demo`)
*.db
*.db-shm
*.db-wal
*.db-journal

# Local environment (committed template lives in .env.example)
.env

# Local Claude Code permission grants (machine-specific)
.claude/settings.local.json

# OS / editor cruft
.DS_Store
